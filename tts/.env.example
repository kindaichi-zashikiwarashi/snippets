# 使うときは .env という名前にコピーする (tts/ の直下)。使わない行は消してよい。

# 話者分離 (pyannote) に必要。使わないなら未設定でよい (警告を出して話者分離なしで続行する)
# https://huggingface.co/settings/tokens で取得する
HF_TOKEN=hf_xxxxxxx

# --- 要約・タイトル生成の頼み先 (詳しくは local-llm/README.md) ---
# local / claude / codex。claude と codex は文字起こしの全文をクラウドへ送る
#LLM_BACKEND=local
# local の接続先とモデル名
#LLM_API_BASE=http://127.0.0.1:8081/v1
#LLM_MODEL=gemma4-chat
# local が応答しないとき起動する systemd --user のユニット。空にすると自動起動しない
#LLM_SERVER_UNIT=llm-swap
# systemd が無い環境 (Windows など) で、local が応答しないとき実行する起動スクリプト
#LLM_SERVER_CMD=
